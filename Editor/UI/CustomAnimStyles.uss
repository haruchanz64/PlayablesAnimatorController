.cah-root {
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
    padding: 10px 12px;
    color: var(--unity-colors-default-text);
}

.cah-card {
    background-color: var(--unity-colors-helpbox-background);
    border-width: 1px;
    border-color: var(--unity-colors-helpbox-border);
    border-radius: 6px;
    padding: 8px 10px;
    margin-bottom: 8px;
    min-width: 0;
}

.cah-section-title {
    font-size: 12px;
    -unity-font-style: bold;
    color: var(--unity-colors-window-text);
    white-space: normal;
    margin-bottom: 5px;
}

.cah-row {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    min-width: 0;
    margin-bottom: 4px;
}

.cah-row > Button {
    margin-right: 4px;
    margin-bottom: 4px;
}

.cah-bar-track {
    height: 10px;
    background-color: var(--unity-colors-slider_groove-background);
    border-radius: 3px;
    overflow: hidden;
    margin-top: 2px;
    margin-bottom: 6px;
}

.cah-bar-fill {
    height: 100%;
    background-color: var(--unity-colors-link-text);
}

.cah-bar-fill--blend {
    background-color: var(--unity-colors-warning-text);
}

.cah-mono {
    font-size: 11px;
    color: var(--unity-colors-default-text);
    white-space: normal;
    flex-shrink: 1;
}

.cah-muted {
    font-size: 11px;
    color: var(--unity-colors-default-text);
    opacity: 0.72;
    white-space: normal;
    flex-shrink: 1;
}
